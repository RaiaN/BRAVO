{
  "name": "bravo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BRAVO \u2014 an AI film studio with a Claude-style interface.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "NODE_USE_SYSTEM_CA=1 next dev",
    "build": "NODE_USE_SYSTEM_CA=1 next build",
    "start": "NODE_USE_SYSTEM_CA=1 next start",
    "lint": "next lint",
    "dev:next": "NODE_USE_SYSTEM_CA=1 next dev -p ${PORT:-3210}",
    "dev:electron": "wait-on http://localhost:${PORT:-3210} && BRAVO_DEV_URL=http://localhost:${PORT:-3210} NODE_USE_SYSTEM_CA=1 electron .",
    "dev:desktop": "concurrently -k -n next,electron -c cyan,magenta \"npm:dev:next\" \"npm:dev:electron\"",
    "start:desktop": "NODE_USE_SYSTEM_CA=1 NODE_ENV=production electron .",
    "build:desktop": "npm run build && electron-builder -m",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:agents": "node tests/lib/run.js"
  },
  "dependencies": {
    "@volcengine/tos-sdk": "^2.9.1",
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.bravo.studio",
    "productName": "BRAVO",
    "asar": false,
    "files": [
      "electron/**/*",
      ".next/**/*",
      "!.next/cache/**/*",
      ".agents/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}/**/*",
      "!**/node_modules/.bin",
      "!**/*.{o,hprof,orig,pyc,pyo,rbc,swp,tod}",
      "!**/.env*"
    ],
    "directories": {
      "output": "dist/${os}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    }
  },
  "author": "BRAVO"
}
