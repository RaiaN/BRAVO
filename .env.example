REGION=ap-southeast-1
SERVICE=ark
VERSION=2024-01-01
BASE_URL=https://ark.ap-southeast-1.byteplusapi.com/
TERMINAL=request
POLL_INTERVAL_MS=3000
POLL_MAX_ATTEMPTS=40

# ---- Ark API (required for generation) --------------------------------------------
# With this set, end users need no key in the UI (the canvas runs key-less against it).
# WARNING: this key then pays for every visitor — put the deployment behind your own
# access control (VPN / SSO proxy).
MODELARK_API_KEY=

# Ark base URL for your region — REQUIRED (no default), e.g.:
#   https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_API_BASE_URL=

# ---- Model / endpoint ids — ALL REQUIRED, NO BUILT-IN DEFAULTS --------------------
# An unconfigured slot ERRORS with the exact variable name — nothing ever silently
# rides another account's endpoint. Ids that look like ep-… are ACCOUNT-SCOPED Ark
# endpoints: create the endpoint in YOUR Ark console (Model Hub → the model → create
# endpoint) and paste its id. Named ids (dola-…, seed-…) are public model names.
MODELARK_MODEL_REASONER=            # Seed 2.0 Pro (reasoning/agents), e.g. seed-2-0-pro-260328
MODELARK_REASONER_PROTOCOL=         # optional: responses|chat — set when the reasoner is an ep-… endpoint id (its API shape can't be inferred from the name)
MODELARK_MODEL_SEEDREAM=            # Seedream 5.0 Lite image endpoint (ep-…)
MODELARK_MODEL_SEEDREAM_PRO=        # Seedream 5.0 Pro, e.g. dola-seedream-5-0-pro-260628
MODELARK_MODEL_SEEDANCE=            # Seedance 2.0 video endpoint (ep-…)
MODELARK_MODEL_SEEDANCE_FAST=       # Seedance 2.0 Fast endpoint (ep-…)
MODELARK_MODEL_SEEDANCE_MINI=       # Seedance 2.0 Mini endpoint (ep-…)
MODELARK_MODEL_SEEDANCE_25=         # Seedance 2.5 (public name: dreamina-seedance-2-5-260628 — needs an active 2.5 resource pack)

# ---- Seed Audio — REQUIRED if the Audio agent is used ------------------------------
BYTEPLUSVOICE_API_KEY=
BYTEPLUSVOICE_BASE_URL=             # e.g. https://voice.ap-southeast-1.bytepluses.com
MODELARK_MODEL_SEED_AUDIO=          # e.g. seed-audio-1.0

# ---- TOS object storage (required for durable media + cloud project saves) --------
# An IAM key pair with access to the bucket, plus the bucket in your region.
MODELARK_ASSET_ACCESS_KEY=
MODELARK_ASSET_SECRET_KEY=
MODELARK_TOS_BUCKET=
MODELARK_TOS_REGION=ap-southeast-1
MODELARK_TOS_ENDPOINT=              # optional; defaults to tos-<region>.bytepluses.com
MODELARK_TOS_OBJECT_PREFIX=         # optional key prefix for staged uploads
MODELARK_TOS_PUBLIC_BASE_URL=       # ONLY if the bucket is public-read; else leave empty (presigned URLs are used)

# ---- Assets API (optional) --------------------------------------------------------
MODELARK_ASSET_GROUP_ID=            # optional: pin the asset-library group; else one stable group is created and reused

