{
 "version": 1,
 "set": "take",
 "params": {
  "frames": { "maxWidth": 768 },
  "still": { "minLuma": 20, "maxLuma": 235, "minBlur": 15, "duplicateMaxBits": 6 },
  "frozen": { "maxBits": 2, "minSeconds": 1 },
  "black": { "maxLuma": 16 },
  "blown": { "minLuma": 240 },
  "scoring": { "deterministicWeight": 0.5, "rubricWeight": 0.5 },
  "provenance": {
   "origin": "seed",
   "note": "seed values for Pipeline V2 stage 7 and 9; luminance on a 0-255 gray frame, blur as Laplacian variance on a 64x64 gray frame, frozen as consecutive-frame dHash deltas at the policy judge fps; every value recalibrates under lane D against measured distributions"
  }
 },
 "questions": [
  {
   "id": "take.subject-present",
   "ruleRef": "SCR-007",
   "form": "binary",
   "passes": ["yes"],
   "scope": "identity",
   "evidence": "frame",
   "evidenceRequired": true,
   "anchors": ["subject"],
   "text": "Is {subject} visible in the frame?"
  },
  {
   "id": "take.subject-held",
   "ruleRef": "SCR-007",
   "form": "binary",
   "passes": ["yes"],
   "scope": "identity",
   "evidence": "sequence",
   "evidenceRequired": true,
   "anchors": ["subject"],
   "text": "Does {subject} keep the same appearance from the first frame shown to the last?"
  },
  {
   "id": "take.setup-readable",
   "ruleRef": "CIN-001",
   "form": "binary",
   "passes": ["yes"],
   "scope": "setup",
   "evidence": "frame",
   "evidenceRequired": true,
   "anchors": ["setup"],
   "text": "Does the framing read as a {setup}?"
  },
  {
   "id": "take.force-visible",
   "ruleRef": "SCR-003",
   "form": "binary",
   "passes": ["yes"],
   "scope": "force",
   "evidence": "frame",
   "evidenceRequired": true,
   "anchors": ["force"],
   "text": "Is this force visible in the frame: {force}?"
  },
  {
   "id": "take.change-visible",
   "ruleRef": "SCR-012",
   "form": "binary",
   "passes": ["yes"],
   "scope": "change",
   "evidence": "sequence",
   "evidenceRequired": true,
   "anchors": ["change"],
   "text": "Across the frames shown, does the picture move from the first state to the second: {change}?"
  },
  {
   "id": "take.anatomy",
   "ruleRef": "CIN-009",
   "form": "choice",
   "options": ["clean", "extra limb", "missing limb", "merged figures"],
   "passes": ["clean"],
   "scope": "artifact",
   "evidence": "frame",
   "evidenceRequired": true,
   "anchors": [],
   "text": "Which of these describes the anatomy of the figures in the frame?"
  },
  {
   "id": "take.morphing",
   "ruleRef": "CIN-009",
   "form": "choice",
   "options": ["stable", "morphing", "flickering"],
   "passes": ["stable"],
   "scope": "artifact",
   "evidence": "sequence",
   "evidenceRequired": true,
   "anchors": [],
   "text": "Which of these describes how the forms hold from one frame to the next?"
  },
  {
   "id": "take.garbled-writing",
   "ruleRef": "CIN-009",
   "form": "binary",
   "passes": ["no"],
   "scope": "artifact",
   "evidence": "frame",
   "evidenceRequired": true,
   "anchors": [],
   "text": "Is there garbled writing anywhere in the frame?"
  },
  {
   "id": "take.stillness-seen",
   "ruleRef": "CIN-009",
   "form": "binary",
   "passes": ["no"],
   "scope": "motion",
   "evidence": "sequence",
   "evidenceRequired": true,
   "anchors": [],
   "measure": "frozen",
   "text": "Is there a stretch where the picture holds completely still across consecutive frames?"
  },
  {
   "id": "take.black-seen",
   "ruleRef": "CIN-009",
   "form": "binary",
   "passes": ["no"],
   "scope": "exposure",
   "evidence": "frame",
   "evidenceRequired": true,
   "anchors": [],
   "measure": "black",
   "text": "Is any frame shown fully dark?"
  }
 ]
}
